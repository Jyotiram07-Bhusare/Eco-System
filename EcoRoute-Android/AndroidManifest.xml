<?xml version="1.0" encoding="utf-8"?>
<!-- EcoRoute for Android: one Activity that shows the EcoRoute web app (assets/www) in a WebView.
     minSdk / targetSdk / version are passed by build.ps1. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ecoroute.app">

    <!-- map tiles, routing, place search and chargers come from OpenStreetMap services; "Use my own server" talks to your backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- your position on the map and during a journey (asked when the app first needs it) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- allowBackup=false: the local profile and journeys are not copied to Google Drive backups.
         usesCleartextTraffic: so that "Use my own server" also works with a plain http:// address on your own network;
         everything the app talks to by default (OpenStreetMap services) uses https. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
