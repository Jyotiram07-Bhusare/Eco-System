<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging: readable console output + a rolling file (logs/ecoroute.log, 14 days, 20 MB per file). -->
<configuration scan="false">
  <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
  <property name="PATTERN" value="%d{HH:mm:ss.SSS} %-5level %-22.22logger{21} %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/ecoroute.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/ecoroute.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>20MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>300MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <logger name="com.ecoroute" level="INFO"/>
  <logger name="org.apache.catalina.core" level="WARN"/>
  <logger name="com.zaxxer.hikari" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
